{
  "id": "drama3-speak",
  "stages": [
    {
      "id": "load-text",
      "type": "load-text",
      "iports": [],
      "config": {
        "path": [
          "speech-1.txt",
          "speech-2.txt"
        ]
      }
    },
    {
      "id": "speak",
      "type": "text-to-speech",
      "iports": [
        {
          "src": "load-text",
          "oport": 0
        }
      ],
      "config": {
        "hf_dir": "fishaudio/drama-3",
        "stream_chunk_frames": 0,
        "interrupt_on_new_text": false,
        "max_frames": 600
      }
    },
    {
      "id": "save-audio",
      "type": "save-audio",
      "iports": [
        {
          "src": "speak",
          "oport": 0
        }
      ],
      "config": {
        "output_path": "drama3-%02d.wav"
      }
    }
  ],
  "subpipelines": []
}
