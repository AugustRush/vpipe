{
  "id": "drama3-clone-voice",
  "stages": [
    {
      "id": "load-reference",
      "type": "load-audio",
      "iports": [],
      "config": {
        "input_url": "reference.wav"
      }
    },
    {
      "id": "reference-pcm",
      "type": "audio-to-pcm",
      "iports": [
        {
          "src": "load-reference",
          "oport": 0
        }
      ],
      "config": {
        "output_sample_rate": 44100,
        "chunk_duration_s": 600,
        "max_chunk_duration_s": 600,
        "flush_on_eos": true
      }
    },
    {
      "id": "load-text",
      "type": "load-text",
      "iports": [],
      "config": {
        "path": [
          "speech-1.txt",
          "speech-2.txt"
        ]
      }
    },
    {
      "id": "speak",
      "type": "text-to-speech",
      "iports": [
        {
          "src": "load-text",
          "oport": 0
        },
        {
          "src": "reference-pcm",
          "oport": 0
        }
      ],
      "config": {
        "hf_dir": "fishaudio/drama-3",
        "reference_text": "The words spoken in reference.wav, as spoken.",
        "wait_for_reference": true,
        "voice_ref_seconds": 12.0,
        "stream_chunk_frames": 0,
        "interrupt_on_new_text": false,
        "max_frames": 600
      }
    },
    {
      "id": "save-audio",
      "type": "save-audio",
      "iports": [
        {
          "src": "speak",
          "oport": 0
        }
      ],
      "config": {
        "output_path": "drama3-clone-%02d.wav"
      }
    }
  ],
  "subpipelines": []
}
