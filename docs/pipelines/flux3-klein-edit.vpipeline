{
  "id": "flux3-klein-edit",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "black-forest-labs/flux-3-image-klein"
      }
    },
    {
      "id": "load-image",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": [
          "reference.jpg"
        ]
      }
    },
    {
      "id": "image-resample",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-image",
          "oport": 0
        }
      ],
      "config": {
        "fit": "pad_to_grid"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "The same scene at night under a full moon: cool blue moonlight from behind, deep shadows, stars above the skyline, warm lit windows. Everything else as in the reference."
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "vae-encode",
      "type": "vae-encode",
      "iports": [
        {
          "src": "image-resample",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "generate-image",
      "type": "generate-image",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "vae-encode",
          "oport": 0
        }
      ],
      "config": {
        "seed": 0
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-image",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "compare-image",
      "type": "compare-image",
      "iports": [
        {
          "src": "load-image",
          "oport": 0
        },
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "save-image",
      "type": "save-image",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        },
        {
          "src": "load-image",
          "oport": 1
        }
      ],
      "config": {
        "path": "flux3-klein-edit.png"
      }
    }
  ],
  "subpipelines": []
}
